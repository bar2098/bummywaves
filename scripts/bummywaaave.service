[Unit]
Description=bummyWAVES XR bridge for waaave_pool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miapi
Environment=DISPLAY=:0
WorkingDirectory=/home/miapi/bummyWAVES
ExecStart=/usr/bin/python3 /home/miapi/bummyWAVES/bridge/bridge.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
